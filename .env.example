# Settings for compose.yaml: copy to .env and uncomment what you need.
# Nothing here is required. The full list is in docs/configuration.md.

# Where llama.cpp answers. Unset, the dashboard uses what the agent finds.
# LLAMA_URL=http://127.0.0.1:8080
# Only if llama-server runs with --api-key (needed for /metrics and /slots).
# LLAMA_API_KEY=

# The dashboard's port, and the agent's (on 127.0.0.1).
# PORT=8000
# AGENT_PORT=9101

# Push alerts: Apprise URLs, separated by spaces. For example ntfy and Telegram:
# NOTIFY_URLS=ntfys://ntfy.sh/your-topic tgram://BOT_TOKEN/CHAT_ID
# Its address, for a link at the end of each alert.
# DASHBOARD_URL=http://gpu-box:8000

# The image version to run.
# TAG=0.1
